#ifndef QKRYLOV_VERSION_H
#define QKRYLOV_VERSION_H

/* Generated by CMake from the project version; do not edit. */
#define QKRYLOV_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define QKRYLOV_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define QKRYLOV_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define QKRYLOV_VERSION_STRING "@PROJECT_VERSION@"

/* Single number for #if comparisons: MAJOR*10000 + MINOR*100 + PATCH. */
#define QKRYLOV_VERSION_NUMBER (QKRYLOV_VERSION_MAJOR * 10000 + QKRYLOV_VERSION_MINOR * 100 + QKRYLOV_VERSION_PATCH)

#endif /* QKRYLOV_VERSION_H */
