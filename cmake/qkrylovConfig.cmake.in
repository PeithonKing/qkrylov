@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# qkrylov is built on Kokkos (and OpenMP when it was available at build time). Consumers need them to resolve
# the imported targets, so ask for them here; point CMAKE_PREFIX_PATH / Kokkos_ROOT at your Kokkos if needed.
find_dependency(Kokkos)
if(@QKRYLOV_HAS_OPENMP@)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/qkrylovTargets.cmake")

check_required_components(qkrylov)
